 static void build_bytes PARAMS ((h8500_opcode_info *, h8500_operand_info *));
 
+/* moppe: the table has only #xx:16 for MOV:G.W and CMP:G.W with an
+   immediate source and a general EA destination (0x07, 0x05 after the
+   EA).  The CPU also has #xx:8 there (0x06, 0x04), sign-extended to the
+   word: use it for a constant in -128..127 (or 0xff80..0xffff) unless
+   written #xx:16, and insist on it when written #xx:8.  (An immediate
+   source EA is another matter: 0x04 there is a byte operation, 0x0C a
+   word one, so word operations have no #xx:8 source.)  Returns OPCODE or
+   a shortened copy in *COPY.  */
+
+static h8500_opcode_info *shrink_imm
+  PARAMS ((h8500_opcode_info *, h8500_opcode_info *));
+
+static h8500_opcode_info *
+shrink_imm (opcode, copy)
+     h8500_opcode_info *opcode;
+     h8500_opcode_info *copy;
+{
+  int k, i, short_op;
+  long v;
+
+  for (k = 1; k < opcode->length; k++)
+    if (opcode->bytes[k].insert == IMM16)
+      break;
+  if (k >= opcode->length)
+    return opcode;
+  for (i = 0; i < opcode->length; i++)
+    if (opcode->bytes[i].insert == CR || opcode->bytes[i].insert == CRB
+	|| opcode->bytes[i].insert == CRW)
+      return opcode;
+  switch (opcode->bytes[k - 1].contents)
+    {
+    case 0x07: short_op = 0x06; break;
+    case 0x05: short_op = 0x04; break;
+    default: short_op = -1; break;
+    }
+  if (opcode->bytes[k - 1].mask != 0xff || opcode->bytes[k - 1].insert != 0)
+    short_op = -1;
+  if (immediate_size == 16)
+    return opcode;
+  if (short_op < 0)
+    {
+      if (immediate_size == 8)
+	as_bad (_("no #xx:8 form of this instruction"));
+      return opcode;
+    }
+  if (immediate.X_op != O_constant || immediate_inpage)
+    {
+      if (immediate_size == 8)
+	as_bad (_("#xx:8 needs a constant"));
+      return opcode;
+    }
+  v = immediate.X_add_number;
+  if (v >= 0xff80 && v <= 0xffff)
+    v -= 0x10000;
+  if (v < -128 || v > 127)
+    {
+      if (immediate_size == 8)
+	as_bad (_("#xx:8 of a word operation is sign-extended: -128..127"));
+      return opcode;
+    }
+  *copy = *opcode;
+  copy->bytes[k - 1].contents = short_op;
+  copy->bytes[k].insert = IMM8;
+  for (i = k + 1; i < opcode->length - 1; i++)
+    copy->bytes[i] = opcode->bytes[i + 1];
+  copy->length--;
+  immediate.X_add_number = v;
+  return copy;
+}
